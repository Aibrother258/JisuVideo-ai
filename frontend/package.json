{
  "name": "huobao-drama-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3013",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "node --import tsx/esm --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:build": "node --import tsx/esm --test tests/build/*.test.mjs",
    "verify": "npm test && npm run test:ui && npm run test:build",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "lucide-vue-next": "^0.511.0",
    "nuxt": "^3.17.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-sonner": "^1.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "@parcel/watcher@2.5.6": true
  }
}
